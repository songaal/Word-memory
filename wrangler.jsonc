{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "word-memory",
  "main": "src/index.js",
  "compatibility_date": "2026-06-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  // Word lists and login sessions (KV namespace "word-memory"). Keys start with "wm:".
  "kv_namespaces": [
    {
      "binding": "WORDS",
      "id": "62473079ad074d29b0cb31d1b9d8e678"
    },
    // The old video-repeat-player app's data (transcripts, translations, history), read only as a fallback
    {
      "binding": "VIDEO_CACHE",
      "id": "3818ed0bb72349d68834d07f056aab23"
    }
  ]
}
